  m_Script: {fileID: 11500000, guid: 6a8b9c0d1e2f4a6b8c0d1e2f4a6b8cdd, type: 3}
  m_Name: NPC1_SettlementSurvivor_Barks
  m_EditorClassIdentifier: Assembly-CSharp::CIS2991Project.Dialogue.DialogueTree
  randomBark: 1
  nodes:
  - text: Oh, and life's usually hard in the wastes.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0
  - text: Every day you get up is another day you survived.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0
  - text: Keep your weapon handy and your eyes open.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0
  - text: You never know what's waiting on the other side of the walls.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0
  - text: Before the war, it used to be different.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0
  - text: Sometimes I think we'll ever have normal lives again.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0
  - text: We've got this settlement, anyway.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0
  - text: Be careful out there.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0

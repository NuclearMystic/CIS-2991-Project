  m_Name: NPC4_Scavenger_Barks
  m_EditorClassIdentifier: Assembly-CSharp::CIS2991Project.Dialogue.DialogueTree
  randomBark: 1
  nodes:
  - text: There's still a lot of useful stuff to be found if you know where to look.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0
  - text: People don't dare go in the old buildings.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0
  - text: Just don't get greedy.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0
  - text: I've lost more friends to bad decisions than to monsters.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0
  - text: Clear the room before you start grabbing everything.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0
  - text: You never know what you're going to get.
    hasChoice: 0
    nextNodeIndex: -1
    yesNextNodeIndex: 0
    noNextNodeIndex: 0

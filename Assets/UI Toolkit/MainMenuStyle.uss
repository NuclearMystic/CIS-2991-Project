:root {
}

.main-menu-button {
    width: 450px;
    height: 80px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    -unity-font-style: bold;
    font-size: 40px;
    color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
}

.settings-button {
    background-color: rgb(39, 128, 32);
}

.settings-button:hover {
    background-color: rgb(11, 65, 6);
}

.play-button {
    background-color: rgb(0, 77, 221);
}

.play-button:hover {
    background-color: rgb(3, 51, 140);
}

.load-button {
    background-color: rgb(226, 0, 13);
}

.load-button:hover {
    background-color: rgb(159, 1, 10);
}

.quit-button {
    background-color: rgb(233, 211, 0);
}

.quit-button:hover {
    background-color: rgb(171, 155, 2);
}

/* ========================= */
/* SETTINGS POPUP            */
/* ========================= */

.settings-container
{
    position: relative;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    justify-content: center;
    align-items: center;

    background-color: rgba(0,0,0,0.55);

    display: none;
}

.settings-window
{
    width: 700px;
    height: 500px;

    background-color: rgba(20,20,20,0.95);

    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;

    border-left-color: white;
    border-right-color: white;
    border-top-color: white;
    border-bottom-color: white;

    padding-left: 25px;
    padding-right: 25px;
    padding-top: 25px;
    padding-bottom: 25px;

    flex-direction: column;
}

.settings-title
{
    color: white;

    font-size: 40px;

    -unity-font-style: bold;

    -unity-text-align: middle-center;

    margin-bottom: 10px;
}

.settings-divider
{
    height: 5px;

    background-color: white;

    margin-bottom: 20px;
}

.settings-row
{
    flex-direction: row;

    align-items: center;

    justify-content: space-between;

    height: 50px;

    margin-bottom: 12px;
}

.settings-label
{
    width: 150px;

    color: white;

    font-size: 20px;
}

.settings-slider
{
    flex-grow: 1;

    margin-left: 15px;
}

.back-button
{
    width: 220px;

    height: 50px;

    margin-top: 30px;

    align-self: center;

    font-size: 20px;
}

.load-slot
{
    height: 70px;

    margin-bottom: 15px;

    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;

    border-left-color: rgb(180,180,180);
    border-right-color: rgb(180,180,180);
    border-top-color: rgb(180,180,180);
    border-bottom-color: rgb(180,180,180);

    justify-content: center;
    padding-left: 20px;
}